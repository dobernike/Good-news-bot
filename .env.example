# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Target channel or group chat ID
# Channel:  @yourchannel  or  -100xxxxxxxxxx
# Group:    -xxxxxxxxxx
TELEGRAM_CHAT_ID=@yourchannel

# NewsAPI key from https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Daily post time in HH:MM UTC (default: 09:00)
POST_TIME=09:00

# Number of articles to include per post (1–3, default: 3)
MAX_ARTICLES=3
