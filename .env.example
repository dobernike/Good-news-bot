# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Target channel or group chat ID
# Channel:  @yourchannel  or  -100xxxxxxxxxx
# Group:    -xxxxxxxxxx
TELEGRAM_CHAT_ID=@yourchannel

# NewsAPI key from https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Comma-separated post times in HH:MM UTC (default: 09:00,18:00)
POST_TIMES=09:00,18:00

# Optional: path to the file that stores posted article URLs (default: posted_urls.json)
# HISTORY_FILE=posted_urls.json
